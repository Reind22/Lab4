<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TicTacToe.Client.Core.ViewModels;assembly=TicTacToe.Client.Core"
             xmlns:loc="clr-namespace:TicTacToe.Client.Localization"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="480"
             x:Class="TicTacToe.Client.Views.MainMenuView"
             x:DataType="vm:MainMenuViewModel">

    <Grid RowDefinitions="Auto,Auto,*">
        <DockPanel Grid.Row="0" Margin="0,8,0,0" x:CompileBindings="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding LanguageLabel, Source={x:Static loc:Localization.Instance}}"
                           Classes="muted" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding AvailableLanguages, Source={x:Static loc:Localization.Instance}}"
                          SelectedItem="{Binding SelectedLanguage, Source={x:Static loc:Localization.Instance}, Mode=TwoWay}"
                          Width="140">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <Border />
        </DockPanel>

        <TextBlock Grid.Row="1" Classes="h1"
                   Text="{Binding AppTitle, Source={x:Static loc:Localization.Instance}}"
                   HorizontalAlignment="Center" Margin="0,16,0,24" />

        <Border Grid.Row="2" Classes="card"
                MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="14">
                <TextBlock Classes="h2"
                           Text="{Binding MainMenuTitle, Source={x:Static loc:Localization.Instance}}" />

                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding NicknameLabel, Source={x:Static loc:Localization.Instance}}"
                               Classes="muted" />
                    <TextBox Text="{Binding Nickname, Mode=TwoWay}"
                             PlaceholderText="{Binding NicknamePlaceholder, Source={x:Static loc:Localization.Instance}}" />
                </StackPanel>

                <Expander Header="{Binding ConnectionExpanderHeader, Source={x:Static loc:Localization.Instance}}">
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding HostLabel, Source={x:Static loc:Localization.Instance}}"
                                       Classes="muted" />
                            <TextBox Text="{Binding Host, Mode=TwoWay}" PlaceholderText="127.0.0.1" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding PortLabel, Source={x:Static loc:Localization.Instance}}"
                                       Classes="muted" />
                            <NumericUpDown Value="{Binding Port, Mode=TwoWay}"
                                           Minimum="1" Maximum="65535"
                                           FormatString="0" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <Button Content="{Binding CreateGameButton, Source={x:Static loc:Localization.Instance}}"
                        Classes="accent"
                        Command="{Binding CreateGameCommand}"
                        HorizontalAlignment="Stretch" />

                <Button Content="{Binding FindGameButton, Source={x:Static loc:Localization.Instance}}"
                        Command="{Binding FindGameCommand}"
                        HorizontalAlignment="Stretch" />

                <Button Content="{Binding LeaderboardButton, Source={x:Static loc:Localization.Instance}}"
                        Command="{Binding ShowLeaderboardCommand}"
                        HorizontalAlignment="Stretch" />

                <TextBlock Text="{Binding StatusMessage}"
                           Classes="error"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
