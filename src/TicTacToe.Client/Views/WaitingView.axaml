<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TicTacToe.Client.Core.ViewModels;assembly=TicTacToe.Client.Core"
             xmlns:loc="clr-namespace:TicTacToe.Client.Localization"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="480"
             x:Class="TicTacToe.Client.Views.WaitingView"
             x:DataType="vm:WaitingViewModel">

    <Border Classes="card" MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="20" HorizontalAlignment="Center">
            <TextBlock Classes="h2"
                       Text="{Binding WaitingTitle, Source={x:Static loc:Localization.Instance}}"
                       HorizontalAlignment="Center" />

            <!-- Анимированные точки -->
            <Border Width="80" Height="80" CornerRadius="40"
                    Background="{DynamicResource AppSurfaceElevatedBrush}"
                    HorizontalAlignment="Center">
                <TextBlock Text="⏳" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Styles>
                        <Style Selector="TextBlock">
                            <Style.Animations>
                                <Animation Duration="0:0:1.5" IterationCount="INFINITE">
                                    <KeyFrame Cue="0%">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </KeyFrame>
                                    <KeyFrame Cue="50%">
                                        <Setter Property="Opacity" Value="1.0" />
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </TextBlock.Styles>
                </TextBlock>
            </Border>

            <ProgressBar IsIndeterminate="True" Width="280" />

            <TextBlock Text="{Binding Message}"
                       Classes="status"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="360"
                       TextAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
